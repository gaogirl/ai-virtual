PORT=5000
NODE_ENV=development

# The demo defaults to an embedded, persistent MongoDB instance.
DEMO_EMBEDDED_DB=true
DEMO_SEED_DATA=true
MONGOMS_DOWNLOAD_DIR=.demo-mongodb-binaries

# Optional: set this to use MongoDB Atlas instead of the embedded database.
MONGO_URI=

# The demo script generates this automatically on first run.
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Optional when the frontend and API use the same demo URL.
CLIENT_URL=http://localhost:5000

# Required for chat, translation, and AI evaluation features.
ZHIPU_API_KEY=
